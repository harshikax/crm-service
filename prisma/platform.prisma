generator client {
  provider = "prisma-client"
  output   = "../src/generated/platform-prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  ARCHIVED
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING_CONFIG
  EXPIRED
  REVOKED
  SUSPENDED
}

// 1. TENANTS TABLE
model tenants {
  id                  Int                   @id @default(autoincrement())
  slug                String                @unique @db.VarChar(100)
  name                String                @db.VarChar(255)
  status              TenantStatus          @default(PROVISIONING)
  error_message       String?               @db.Text
  db_name             String                @db.VarChar(100)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  applications        applications[]
  connections         crm_connections[]
  audit_logs          platform_audit_logs[]
}

// 2. APPLICATIONS TABLE (COD, DOM, CRM)
model applications {
  id                  Int                   @id @default(autoincrement())
  tenant_id           Int
  name                String                @db.VarChar(255)
  slug                String                @db.VarChar(100)
  base_url            String                @db.VarChar(255)
  status              ApplicationStatus     @default(ACTIVE)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  tenant              tenants               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  oauth_clients       oauth_clients[]
  connections         crm_connections[]
  audit_logs          platform_audit_logs[]

  @@unique([tenant_id, slug])
}

// 3. OAUTH CLIENTS TABLE
model oauth_clients {
  id                  Int                   @id @default(autoincrement())
  application_id      Int
  client_id           String                @unique @db.VarChar(100)
  client_secret       String                @db.VarChar(255)
  client_secret_last4 String?               @db.VarChar(10)
  name                String                @db.VarChar(255)
  is_active           Boolean               @default(true)
  redirect_uris       String[]
  scopes              String[]
  grant_types         String[]
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  application         applications          @relation(fields: [application_id], references: [id], onDelete: Cascade)
}

// 4. CRM CONNECTIONS TABLE
model crm_connections {
  id                  Int                   @id @default(autoincrement())
  tenant_id           Int
  application_id      Int
  status              ConnectionStatus      @default(DISCONNECTED)
  connected_at        DateTime?
  disconnected_at     DateTime?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  tenant              tenants               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  application         applications          @relation(fields: [application_id], references: [id], onDelete: Cascade)
}

// 5. CONSENTS TABLE
model consents {
  id                  Int                   @id @default(autoincrement())
  user_id             BigInt
  client_id           String                @db.VarChar(100)
  scopes              String                @db.VarChar(255)
  granted_at          DateTime              @default(now())
}

// 6. PLATFORM AUDIT LOGS
model platform_audit_logs {
  id                  Int                   @id @default(autoincrement())
  tenant_id           Int?
  application_id      Int?
  action              String                @db.VarChar(100)
  actor               String?               @db.VarChar(100)
  details             String?               @db.Text
  ip_address          String?               @db.VarChar(50)
  created_at          DateTime              @default(now())

  tenant              tenants?              @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  application         applications?         @relation(fields: [application_id], references: [id], onDelete: SetNull)
}

// 7. PLATFORM ROLES
model platform_roles {
  id                  Int                         @id @default(autoincrement())
  name                String                      @unique @db.VarChar(100)
  is_system           Boolean                     @default(false)
  created_at          DateTime                    @default(now())
  updated_at          DateTime                    @updatedAt

  users               platform_users[]
  role_permissions    platform_role_permissions[]
}

// 8. PLATFORM USERS (SUPER ADMIN & PLATFORM OPERATORS)
model platform_users {
  id                  Int                   @id @default(autoincrement())
  role_id             Int
  name                String                @db.VarChar(255)
  email               String                @unique @db.VarChar(255)
  password            String                @db.VarChar(255)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  role                platform_roles        @relation(fields: [role_id], references: [id], onDelete: Restrict)
}

// 9. PLATFORM PERMISSION CATEGORIES
model platform_permission_categories {
  id                  Int                         @id @default(autoincrement())
  name                String                      @unique @db.VarChar(100)
  created_at          DateTime                    @default(now())
  updated_at          DateTime                    @updatedAt

  permissions         platform_permissions[]
}

// 10. PLATFORM PERMISSIONS 
model platform_permissions {
  id                  Int                               @id @default(autoincrement())
  category_id         Int?
  code                String                            @unique @db.VarChar(100)
  name                String?                           @db.VarChar(150)
  description         String?                           @db.VarChar(255)
  created_at          DateTime                          @default(now())
  updated_at          DateTime                          @updatedAt

  category            platform_permission_categories?   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  role_permissions    platform_role_permissions[]
}

// 11. PLATFORM ROLE PERMISSIONS 
model platform_role_permissions {
  role_id       Int
  permission_id Int

  role          platform_roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    platform_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
}